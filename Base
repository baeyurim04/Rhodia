# Dynamically plotting X vs Y positions and Galactocentric radius vs |Z|
# Definining the geleacocentric radius for the harris data and finding its sigma values

R = np.sqrt(X**2+Y**2)
R_std = np.std(R)

# Definining conditions on R  vs |Z| plot to colour code by no. of sigmas
conditions = (R>3*R_std, (R>R_std) & (R<3*R_std), R<R_std)
cond_colours = ('blue','green', 'red')
point_colours = np.select(conditions, cond_colours, default = 'green')

#Plotting R vs |Z|
plt.figure(1)
plt.scatter(R,abs(Z), c=point_colours, alpha = 0.4)
plt.xlabel(r"Galactocentric Radius ($R = \sqrt{X^{2}+Y^{2}}$) (kpc)")
plt.ylabel("Height from Plane (kpc)")
plt.title("Galactocentric Radius vs Height over Galactic Plane")
